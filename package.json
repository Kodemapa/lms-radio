{
  "name": "obgyn-elms",
  "private": true,
  "description": "GIFS e-LMS + Simulator Platform (monorepo)",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start --filter=@obgyn/web --filter=@obgyn/api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @obgyn/api db:generate",
    "db:migrate": "pnpm --filter @obgyn/api db:migrate",
    "db:seed": "pnpm --filter @obgyn/api db:seed",
    "desktop": "pnpm --filter @obgyn/desktop start",
    "mobile": "pnpm --filter @obgyn/mobile start"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3"
  }
}
