# --- Runtime ---
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
# Comma-separated list of web origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Set true when running behind a reverse proxy / the web BFF so req.ip is the client IP
TRUST_PROXY=false
SWAGGER_ENABLED=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://elms:elms@localhost:5432/elms?schema=public

# --- Auth --- (generate each with: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-123
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_SECRET=change-me-change-me-change-me-change-me-456
OTP_TTL_SECONDS=300
# Optional 2Factor.in SMS delivery. Use an approved template name (e.g. OTP1).
TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE=OTP1
# Active devices per learner/instructor account; 0 = no limit. Admins are never limited.
MAX_DEVICES_PER_USER=0
# Live exam proctoring: STUN/TURN servers (JSON array of RTCIceServer). STUN works on most
# networks; for strict firewalls add your own TURN server, e.g.
# [{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.in:3478","username":"u","credential":"p"}]
PROCTOR_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# --- Outgoing email: this app's OWN ZeptoMail Mail Agent (SMTP) ---
# Leave SMTP_HOST empty to turn email off; the app keeps working without it.
# Host from this Mail Agent's SMTP page: smtp.zeptomail.in or smtp.zeptomail.com.
SMTP_HOST=
# 465 with implicit TLS. Do not use 587: it is blocked outbound on the production VPS.
SMTP_PORT=465
SMTP_SECURE=true
# Always the literal string emailapikey
SMTP_USER=
# This Mail Agent's SMTP token. Never commit it; never reuse another app's token.
SMTP_PASS=
# Sender on a domain verified for this Mail Agent, e.g. GIFS e-LMS <no-reply@kodemapa.com>
MAIL_FROM=
# Public web address used for links in emails (no trailing slash)
APP_URL=http://localhost:3000

# Local-only setup script (not read by the API or production builds).
# Set these in apps/api/.env only when configuring existing local test accounts.
DEV_ADMIN_PASSWORD=
DEV_INSTRUCTOR_PASSWORD=
DEV_INSTRUCTOR2_PASSWORD=
DEV_LEARNER_PASSWORD=

# Development only: turn off sequential lesson locks so any lesson opens without
# finishing the earlier ones. The API refuses to start if this is true in production.
DEV_UNLOCK_LESSONS=true

# --- Protected media ---
MEDIA_SIGNING_SECRET=change-me-change-me-change-me-change-me-789
# Hard cap is 300 seconds (CLAUDE.md rule 2)
MEDIA_URL_TTL_SECONDS=300

# --- Storage ---
# local: files under LOCAL_STORAGE_DIR (development only). s3: S3/MinIO below.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage

# S3-compatible storage (production; must stay in India)
S3_REGION=ap-south-1
S3_BUCKET=elms-media
# Local MinIO (docker-compose). Leave S3_ENDPOINT empty for AWS.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=elms
S3_SECRET_ACCESS_KEY=elms-dev-password

# --- Video DRM (docs/03-CONTENT-PROTECTION.md) ---
# none: clear progressive video. clearkey: development adapter (refused in production).
DRM_PROVIDER=clearkey
# Wraps per-video content keys at rest: openssl rand -base64 48
DRM_KEY_ENCRYPTION_KEY=
# cbcs = one CMAF package for Widevine + PlayReady + FairPlay.
DRM_PROTECTION_SCHEME=cbcs
# true: refuse software DRM (Chrome desktop, Widevine L3) so captures are always black.
DRM_REQUIRE_HARDWARE=false
DRM_AUTO_PACKAGE=true
# Install with tools/install-media-tools.sh
FFMPEG_PATH=ffmpeg
SHAKA_PACKAGER_PATH=../../tools/bin/packager

# --- Response cache (src/cache) ---
# Per-user + public response cache. With REDIS_URL set, all API instances share it
# (docker-compose has Redis on 6379); empty = in-memory cache per process.
CACHE_ENABLED=true
# Leave empty locally (no Redis needed); if set but unreachable, the in-memory cache is used.
REDIS_URL=
CACHE_KEY_PREFIX=elms:
CACHE_MEMORY_MAX_ENTRIES=5000
# A Redis command slower than this is treated as a miss (the request uses the database).
CACHE_REDIS_COMMAND_TIMEOUT_MS=500
# Production with more than one API process (PM2 cluster, several servers): set REDIS_URL,
# otherwise invalidations are not shared and a change can show stale for up to 60 s.

# --- Logging and tracing (src/observability) ---
# fatal | error | warn | info | debug | verbose
LOG_LEVEL=info
# json (log shippers) | pretty (terminal). Default: pretty in development, json in production.
LOG_FORMAT=
LOG_REQUESTS=true
# Local tracing, no Docker/Jaeger needed: one summary line per request in this terminal
# (total time, DB query count + time, slowest steps), keyed by the browser's x-trace-id.
# Adds some overhead: turn on while investigating, not permanently.
TRACE_CONSOLE=false
# OpenTelemetry traces over OTLP/HTTP to a trace backend (deployment). Empty = off.
# Local: docker compose up jaeger, then http://localhost:4318 (UI at http://localhost:16686)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=elms-api
