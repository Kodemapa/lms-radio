# --- Runtime ---
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
# Comma-separated list of web origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Set true when running behind a reverse proxy / the web BFF so req.ip is the client IP
TRUST_PROXY=false
SWAGGER_ENABLED=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://elms:elms@localhost:5432/elms?schema=public

# --- Auth --- (generate each with: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-123
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_SECRET=change-me-change-me-change-me-change-me-456
OTP_TTL_SECONDS=300
# Optional 2Factor.in SMS delivery. Use an approved template name (e.g. OTP1).
TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE=OTP1
MAX_DEVICES_PER_USER=2

# Local-only setup script (not read by the API or production builds).
# Set these in apps/api/.env only when configuring existing local test accounts.
DEV_ADMIN_PASSWORD=
DEV_INSTRUCTOR_PASSWORD=
DEV_INSTRUCTOR2_PASSWORD=
DEV_LEARNER_PASSWORD=

# Development only: turn off sequential lesson locks so any lesson opens without
# finishing the earlier ones. The API refuses to start if this is true in production.
DEV_UNLOCK_LESSONS=true

# --- Protected media ---
MEDIA_SIGNING_SECRET=change-me-change-me-change-me-change-me-789
# Hard cap is 300 seconds (CLAUDE.md rule 2)
MEDIA_URL_TTL_SECONDS=300

# --- Storage ---
# local: files under LOCAL_STORAGE_DIR (development only). s3: S3/MinIO below.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage

# S3-compatible storage (production; must stay in India)
S3_REGION=ap-south-1
S3_BUCKET=elms-media
# Local MinIO (docker-compose). Leave S3_ENDPOINT empty for AWS.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=elms
S3_SECRET_ACCESS_KEY=elms-dev-password

# --- Video DRM (docs/03-CONTENT-PROTECTION.md) ---
# none: clear progressive video. clearkey: development adapter (refused in production).
DRM_PROVIDER=clearkey
# Wraps per-video content keys at rest: openssl rand -base64 48
DRM_KEY_ENCRYPTION_KEY=
# cbcs = one CMAF package for Widevine + PlayReady + FairPlay.
DRM_PROTECTION_SCHEME=cbcs
# true: refuse software DRM (Chrome desktop, Widevine L3) so captures are always black.
DRM_REQUIRE_HARDWARE=false
DRM_AUTO_PACKAGE=true
# Install with tools/install-media-tools.sh
FFMPEG_PATH=ffmpeg
SHAKA_PACKAGER_PATH=../../tools/bin/packager
