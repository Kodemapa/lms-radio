# Base URL of @obgyn/api, used server-side only (BFF route handlers, server components, middleware)
API_URL=http://localhost:4000
# Public URL of @obgyn/api as the browser sees it (course thumbnails, uploads)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Development only: shows "use code …" on the sign-in page. Match the API's DEV_FIXED_OTP.
DEV_FIXED_OTP_HINT=123456
