# Base URL of @obgyn/api, used server-side only (BFF route handlers, server components, middleware)
API_URL=http://localhost:4000
# Public URL of @obgyn/api as the browser sees it (course thumbnails, uploads)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of this site (sitemap, robots.txt, Open Graph, certificate links)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# One JSON access-log line per BFF call (/api/proxy/*, sign-in) with the trace ID that
# also appears in the API log. Set to false to silence; warnings/errors always print.
LOG_REQUESTS=true
