{
  "name": "@obgyn/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for the web app with OS-level capture blocking",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@obgyn/config": "workspace:*",
    "@types/node": "22.20.5",
    "electron": "38.8.6",
    "electron-builder": "26.18.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.example.obgynelms",
    "productName": "ObGyn e-LMS",
    "directories": { "output": "release" },
    "files": ["dist/**", "package.json"],
    "mac": { "hardenedRuntime": true, "category": "public.app-category.education" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
